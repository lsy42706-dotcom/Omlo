.login-page { min-height: 100vh; box-sizing: border-box; padding: 46rpx 36rpx 80rpx; background: linear-gradient(165deg, #eef3ff 0%, #f6f8fc 49%, #f9fbff 100%); }
.login-brand { display: flex; align-items: center; gap: 14rpx; color: #1f3864; font-size: 29rpx; font-weight: 750; }
.brand-mark { display: flex; justify-content: center; align-items: center; width: 58rpx; height: 58rpx; border-radius: 16rpx; background: #315be8; color: #fff; font-size: 29rpx; }
.login-hero { display: flex; flex-direction: column; margin: 130rpx 14rpx 62rpx; }
.eyebrow { color: #5778bc; font-size: 20rpx; font-weight: 700; letter-spacing: 3rpx; }
.title { margin-top: 18rpx; color: #172e54; font-size: 50rpx; font-weight: 750; line-height: 1.3; }
.description { margin-top: 20rpx; max-width: 630rpx; color: #697d98; font-size: 26rpx; line-height: 1.75; }
.login-card { display: flex; flex-direction: column; padding: 42rpx 38rpx 38rpx; border: 1rpx solid #e3eaf4; border-radius: 28rpx; background: #fff; box-shadow: 0 18rpx 56rpx rgba(36, 60, 105, .08); }
.card-symbol { display: flex; align-items: center; justify-content: center; width: 78rpx; height: 78rpx; border-radius: 20rpx; background: #eaf0ff; color: #315be8; font-size: 45rpx; }
.card-title { margin-top: 25rpx; color: #203655; font-size: 34rpx; font-weight: 750; }
.card-copy { margin-top: 11rpx; color: #75849a; font-size: 24rpx; line-height: 1.6; }
.login-button { width: 100%; height: 94rpx; line-height: 94rpx; margin: 42rpx 0 0; border-radius: 16rpx; background: #315be8; color: #fff; font-size: 28rpx; font-weight: 700; box-shadow: 0 10rpx 20rpx rgba(49, 91, 232, .18); }
.login-button[disabled] { background: #9badde; color: #fff; }
.setup-note, .error-note { margin-top: 18rpx; color: #a56627; font-size: 22rpx; line-height: 1.5; }
.error-note { color: #b04444; }
.privacy-note { margin: 43rpx 20rpx 0; color: #8491a3; text-align: center; font-size: 21rpx; line-height: 1.65; }
