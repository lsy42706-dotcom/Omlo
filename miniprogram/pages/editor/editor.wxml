<view class="editor-page safe-bottom">
  <view class="hero">
    <view class="hero-top"><view class="brand-mark">简</view><text class="brand-name">简历工坊</text><button class="logout-button" bindtap="logout">{{localOnly ? '返回登录' : '退出登录'}}</button></view>
    <text class="hero-eyebrow">YOUR NEXT CHAPTER</text>
    <text class="hero-title">把经历写成机会</text>
    <text class="hero-subtitle">分步整理内容，随时预览你的简历。</text>
    <view class="hero-progress"><view><text>内容完善度</text><text class="progress-number">{{progress}}%</text></view><view class="progress-track"><view style="width: {{progress}}%"></view></view></view>
  </view>

  <view class="status-row"><view class="status-dot"></view><text>{{saveStatus}}</text><button wx:if="{{!localOnly && saveStatus !== '已同步到云端' && saveStatus !== '正在同步云端…' && saveStatus !== '保存中…'}}" class="sync-button" bindtap="retryCloud">{{saveStatus === '其他设备更新了草稿' ? '处理冲突' : '立即同步'}}</button><text wx:if="{{localOnly}}" class="status-note">未连接云端</text></view>

  <scroll-view class="step-scroll" scroll-x="true" enable-flex="true" show-scrollbar="false">
    <view class="step-list">
      <view wx:for="{{steps}}" wx:key="*this" class="step-pill {{activeStep === index ? 'is-active' : ''}}" data-index="{{index}}" bindtap="selectStep">
        <text class="step-number">{{index + 1}}</text><text>{{item}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="form-card">
    <view class="card-heading"><text class="card-kicker">STEP 0{{activeStep + 1}} / 05</text><text class="card-title">{{steps[activeStep]}}</text>
      <text class="card-subtitle" wx:if="{{activeStep === 0}}">先让对方认识你，再用经历留下印象。</text>
      <text class="card-subtitle" wx:elif="{{activeStep === 1}}">可以添加多段教育经历，按需要保留。</text>
      <text class="card-subtitle" wx:elif="{{activeStep === 2}}">写清项目职责与成果，预览会整理成要点。</text>
      <text class="card-subtitle" wx:elif="{{activeStep === 3}}">技能分类可以自由增加、编辑或删除。</text>
      <text class="card-subtitle" wx:else>选择合适版式，保持内容的主次清晰。</text>
    </view>

    <block wx:if="{{activeStep === 0}}">
      <view class="field"><text class="field-label">简历名称</text><input value="{{resume.title}}" maxlength="30" placeholder="例如：嵌入式开发岗位简历" bindinput="onTitleInput" /></view>
      <view class="field"><text class="field-label">姓名 <text class="required">*</text></text><input value="{{resume.basics.name}}" maxlength="60" placeholder="你的姓名" data-field="name" bindinput="onBasicInput" /></view>
      <view class="field"><text class="field-label">求职岗位 <text class="required">*</text></text><input value="{{resume.basics.jobTitle}}" maxlength="80" placeholder="例如：嵌入式软件工程师" data-field="jobTitle" bindinput="onBasicInput" /></view>
      <view class="field"><text class="field-label">手机号码</text><input value="{{resume.basics.phone}}" maxlength="40" type="number" placeholder="联系电话" data-field="phone" bindinput="onBasicInput" /></view>
      <view class="field"><text class="field-label">电子邮箱</text><input value="{{resume.basics.email}}" maxlength="100" placeholder="你的邮箱地址" data-field="email" bindinput="onBasicInput" /></view>
      <view class="field"><text class="field-label">所在城市</text><input value="{{resume.basics.location}}" maxlength="80" placeholder="例如：上海" data-field="location" bindinput="onBasicInput" /></view>
      <view class="field"><text class="field-label">个人简介</text><text class="field-hint">用换行或句号分隔，预览中会变成要点</text><textarea value="{{resume.basics.summary}}" maxlength="300" placeholder="用两三句话介绍你的方向与优势" data-field="summary" bindinput="onBasicInput" /></view>
    </block>

    <block wx:elif="{{activeStep === 1}}">
      <view wx:for="{{resume.educations}}" wx:key="id" class="entry-card">
        <view class="entry-heading"><view><text class="entry-index">教育经历 {{index + 1}}</text><text class="entry-name">{{item.school || '待填写学校'}}</text></view><button class="text-danger" data-index="{{index}}" bindtap="removeEducation">删除</button></view>
        <view class="field"><text class="field-label">学校名称</text><input value="{{item.school}}" maxlength="100" placeholder="学校名称" data-index="{{index}}" data-field="school" bindinput="onEducationInput" /></view>
        <view class="field"><text class="field-label">专业</text><input value="{{item.major}}" maxlength="100" placeholder="所学专业" data-index="{{index}}" data-field="major" bindinput="onEducationInput" /></view>
        <view class="field"><text class="field-label">学历</text><input value="{{item.degree}}" maxlength="60" placeholder="例如：本科" data-index="{{index}}" data-field="degree" bindinput="onEducationInput" /></view>
        <view class="field-row"><view class="field"><text class="field-label">开始时间</text><input value="{{item.startDate}}" maxlength="30" placeholder="2023.09" data-index="{{index}}" data-field="startDate" bindinput="onEducationInput" /></view><view class="field"><text class="field-label">结束时间</text><input value="{{item.endDate}}" maxlength="30" placeholder="2027.06" data-index="{{index}}" data-field="endDate" bindinput="onEducationInput" /></view></view>
        <view class="field"><text class="field-label">所在城市</text><input value="{{item.location}}" maxlength="80" placeholder="城市（可选）" data-index="{{index}}" data-field="location" bindinput="onEducationInput" /></view>
      </view>
      <button class="add-button" bindtap="addEducation">＋ 添加教育经历</button>
    </block>

    <block wx:elif="{{activeStep === 2}}">
      <view wx:for="{{resume.projects}}" wx:key="id" class="entry-card">
        <view class="entry-heading"><view><text class="entry-index">项目 {{index + 1}}</text><text class="entry-name">{{item.name || '待填写项目'}}</text></view><button class="text-danger" data-index="{{index}}" bindtap="removeProject">删除</button></view>
        <view class="field"><text class="field-label">项目名称</text><input value="{{item.name}}" maxlength="100" placeholder="项目名称" data-index="{{index}}" data-field="name" bindinput="onProjectInput" /></view>
        <view class="field"><text class="field-label">担任角色</text><input value="{{item.role}}" maxlength="80" placeholder="例如：嵌入式开发" data-index="{{index}}" data-field="role" bindinput="onProjectInput" /></view>
        <view class="field-row"><view class="field"><text class="field-label">开始时间</text><input value="{{item.startDate}}" maxlength="30" placeholder="2026.03" data-index="{{index}}" data-field="startDate" bindinput="onProjectInput" /></view><view class="field"><text class="field-label">结束时间</text><input value="{{item.endDate}}" maxlength="30" placeholder="2026.06" data-index="{{index}}" data-field="endDate" bindinput="onProjectInput" /></view></view>
        <view class="field"><text class="field-label">项目描述</text><text class="field-hint">一句话写目标、方案或你的工作</text><textarea value="{{item.description}}" maxlength="500" placeholder="项目做了什么？你负责什么？" data-index="{{index}}" data-field="description" bindinput="onProjectInput" /></view>
        <text class="field-label achievements-label">项目成果</text>
        <view wx:for="{{item.achievements}}" wx:for-item="achievement" wx:for-index="achievementIndex" wx:key="achievementIndex" class="achievement-row">
          <input value="{{achievement}}" maxlength="250" placeholder="写出可验证的成果" data-index="{{index}}" data-achievement="{{achievementIndex}}" bindinput="onAchievementInput" />
          <button data-index="{{index}}" data-achievement="{{achievementIndex}}" bindtap="removeAchievement" aria-label="删除这条项目成果">×</button>
        </view>
        <button class="subtle-add" data-index="{{index}}" bindtap="addAchievement">＋ 添加成果</button>
      </view>
      <button class="add-button" bindtap="addProject">＋ 添加项目经历</button>
    </block>

    <block wx:elif="{{activeStep === 3}}">
      <view wx:for="{{resume.skillEntries}}" wx:key="id" class="entry-card skill-card">
        <view class="entry-heading"><view><text class="entry-index">技能分类 {{index + 1}}</text><text class="entry-name">{{item.label || '待填写分类'}}</text></view><button class="text-danger" data-index="{{index}}" bindtap="removeSkill">删除</button></view>
        <view class="field"><text class="field-label">分类名称</text><input value="{{item.label}}" maxlength="30" placeholder="例如：编程语言" data-index="{{index}}" data-field="label" bindinput="onSkillInput" /></view>
        <view class="field"><text class="field-label">技能内容</text><input value="{{item.value}}" maxlength="160" placeholder="例如：C、Python、FreeRTOS" data-index="{{index}}" data-field="value" bindinput="onSkillInput" /></view>
      </view>
      <button class="add-button" bindtap="addSkill">＋ 添加技能分类</button>
      <view class="field evaluation-field"><text class="field-label">自我评价</text><textarea value="{{resume.selfEvaluation}}" maxlength="300" placeholder="补充你的工作方式或个人优势" bindinput="onEvaluationInput" /></view>
    </block>

    <block wx:else>
      <text class="group-label">选择模板</text>
      <view class="template-grid"><view wx:for="{{templates}}" wx:key="id" class="template-card {{settings.template === item.id ? 'selected' : ''}}" data-template="{{item.id}}" bindtap="selectTemplate">
        <view class="template-sheet template-sheet-{{item.id}}"><view class="sheet-head"></view><view class="sheet-line long"></view><view class="sheet-line"></view><view class="sheet-rule"></view><view class="sheet-line long"></view><view class="sheet-line short"></view></view>
        <text class="template-name">{{item.name}}</text><text class="template-note">{{item.note}}</text><text wx:if="{{settings.template === item.id}}" class="selected-mark">✓</text>
      </view></view>
      <text class="group-label">强调色</text>
      <view class="accent-row"><view wx:for="{{accents}}" wx:key="*this" class="accent-swatch {{settings.accent === item ? 'selected' : ''}}" style="background: {{item}}" data-color="{{item}}" bindtap="selectAccent"><text wx:if="{{settings.accent === item}}">✓</text></view></view>
      <text class="group-label">内容密度</text>
      <view class="segmented"><view class="{{settings.spacing === 'compact' ? 'selected' : ''}}" data-spacing="compact" bindtap="selectSpacing">紧凑</view><view class="{{settings.spacing === 'standard' ? 'selected' : ''}}" data-spacing="standard" bindtap="selectSpacing">标准</view><view class="{{settings.spacing === 'comfortable' ? 'selected' : ''}}" data-spacing="comfortable" bindtap="selectSpacing">舒展</view></view>
      <view class="setting-row"><view><text>隐藏空白模块</text><text class="setting-hint">让预览只显示已填写的内容</text></view><switch checked="{{settings.hideEmptySections}}" color="#315be8" bindchange="toggleEmpty" /></view>
      <view class="backup-box"><text class="backup-title">备份与迁移</text><text class="backup-help">与网页版兼容。复制 JSON 后可在另一端导入。</text><view class="backup-actions"><button bindtap="copyBackup">复制备份</button><button bindtap="importBackup">从剪贴板导入</button></view><button wx:if="{{hasLocalBackup}}" class="restore-button" bindtap="restoreLocalBackup">恢复上次保留的本机草稿</button><button class="clear-link" bindtap="clearResume">清空简历内容</button></view>
    </block>
  </view>

  <view class="bottom-actions"><button class="back-button" wx:if="{{activeStep > 0}}" bindtap="previousStep">上一步</button><button class="preview-button" bindtap="openPreview">预览</button><button class="next-button" bindtap="nextStep">{{activeStep === 4 ? '完成编辑' : '下一步'}} →</button></view>
</view>
